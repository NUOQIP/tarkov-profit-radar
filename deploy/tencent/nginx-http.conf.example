# Temporary public-IP trial. Use HTTPS with a domain for the lasting public URL.
# On a fresh dedicated server, disable Ubuntu's default site before enabling this.
server {
    listen 80 default_server;
    server_name _;
    server_tokens off;
    access_log /var/log/nginx/tarkov-radar.access.log;
    error_log /var/log/nginx/tarkov-radar.error.log;
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
