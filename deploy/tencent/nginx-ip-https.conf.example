# Replace SERVER_IP after a trusted certificate named radar-ip has been issued.
server {
    listen 80 default_server;
    server_name SERVER_IP;
    server_tokens off;
    location ^~ /.well-known/acme-challenge/ { root /var/www/tarkov-acme; }
    location / { return 301 https://SERVER_IP$request_uri; }
}
server {
    listen 443 ssl default_server;
    server_name SERVER_IP;
    ssl_certificate /etc/letsencrypt/live/radar-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/radar-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 512k;
    access_log /var/log/nginx/tarkov-radar.access.log;
    error_log /var/log/nginx/tarkov-radar.error.log;
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
